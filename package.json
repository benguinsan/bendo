{
  "name": "bendo",
  "version": "0.1.2",
  "private": true,
  "description": "A project created with create-benguin-app",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "format:check": "oxfmt --check",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:build": "docker build -t bendo .",
    "docker:run": "docker run --rm -p 3000:3000 bendo",
    "tf:init:dev": "terraform -chdir=terraform/environment/dev init",
    "tf:plan:dev": "terraform -chdir=terraform/environment/dev plan",
    "tf:apply:dev": "terraform -chdir=terraform/environment/dev apply",
    "tf:destroy:dev": "terraform -chdir=terraform/environment/dev destroy",
    "tf:init:prod": "terraform -chdir=terraform/environment/prod init",
    "tf:plan:prod": "terraform -chdir=terraform/environment/prod plan",
    "tf:apply:prod": "terraform -chdir=terraform/environment/prod apply",
    "tf:destroy:prod": "terraform -chdir=terraform/environment/prod destroy"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@clerk/nextjs": "^7.7.0",
    "@clerk/themes": "^2.4.57",
    "@clerk/ui": "^1.30.8",
    "@supabase/supabase-js": "^2.112.4",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "ultracite": "^7.10.6"
  },
  "optionalDependencies": {
    "utf-8-validate": "^5.0.10"
  }
}
