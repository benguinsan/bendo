# Only http: or https: (data:/file: rejected). Example:
# BENDO_APP_URL=http://127.0.0.1:3000

# Public Vercel origin for privileged API + /api/me cutover (not a secret).
# Required for `npm run build:bendo` — prepare loads this file into process.env
# (if unset in the shell) then bakes the URL into bendo-public-config.json.
# Electron injects into spawned Next and deletes CLERK_SECRET_KEY +
# SUPABASE_SERVICE_ROLE_KEY from the child env (secrets stay on Vercel).
# BENDO_CLOUD_API_URL=https://your-app.vercel.app

# Path to the Next.js app (default: ../bendo-app relative to this package).
# Used only when BENDO_APP_URL is not already reachable — Electron then runs `npm run dev` there.
# BENDO_APP_DIR=/absolute/path/to/bendo-app

# How long to wait for a spawned Next server (ms). Default 60000.
# BENDO_SPAWN_TIMEOUT_MS=60000

# Health probe for Bendo spawn/attach (http/https). Default: {BENDO_APP_URL origin}/api/health
# BENDO_HEALTH_URL=http://127.0.0.1:3000/api/health

# Path to the DeepSeek Harness checkout (default: ../deepseek-harness).
# Used only when BENDO_HARNESS_HEALTH_URL is not already healthy — Electron then runs
# `pnpm dsh web --patch './bendo-agent(doro)/cordis.yml' --no-open` there.
# BENDO_HARNESS_DIR=/absolute/path/to/deepseek-harness

# dsh web host (http/https only). Default: http://127.0.0.1:3080
# Changing the port here also changes the default injected DSH_CHAT_BRIDGE_URL
# ({origin}/bendo-chat) unless DSH_CHAT_BRIDGE_URL is set for the session.
# BENDO_HARNESS_URL=http://127.0.0.1:3080

# Health probe for harness spawn/attach. Default: {BENDO_HARNESS_URL origin}/bendo-chat
# BENDO_HARNESS_HEALTH_URL=http://127.0.0.1:3080/bendo-chat

# How long to wait for a spawned harness (ms). Default 90000.
# BENDO_HARNESS_SPAWN_TIMEOUT_MS=90000

# Optional session-only bridge overrides (never written to userData/bridge-credentials.json).
# If unset, Electron injects URL from BENDO_HARNESS_URL + /bendo-chat and a secret from
# userData (generated/rotated) into spawned Next + harness.
# DSH_CHAT_BRIDGE_URL=http://127.0.0.1:3080/bendo-chat
# DSH_CHAT_BRIDGE_SECRET=replace_with_bridge_secret

# Optional TTL for rotating userData bridge secret (ms). Default 30 days.
# BENDO_BRIDGE_SECRET_TTL_MS=2592000000
