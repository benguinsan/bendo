# Only http: or https: (data:/file: rejected). Example:
# BENDO_APP_URL=http://127.0.0.1:3000

# Path to the Next.js app (default: ../bendo-app relative to this package).
# Used only when BENDO_APP_URL is not already reachable — Electron then runs `npm run dev` there.
# BENDO_APP_DIR=/absolute/path/to/bendo-app

# How long to wait for a spawned Next server (ms). Default 60000.
# BENDO_SPAWN_TIMEOUT_MS=60000
